
{
  "expo": {
    "name": "NotesApp",
    "slug": "NotesApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "notesapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sharonmashai.notesapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "568ae75e-818c-40dd-be56-dbb905cb5aea"
      }
    }
  }
}
